<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pill_radius" />
            <solid android:color="@color/track_inactive" />
            <size android:height="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/pill_radius" />
                <gradient
                    android:startColor="@color/header_gradient_end"
                    android:endColor="@color/header_gradient_start"
                    android:angle="0" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
