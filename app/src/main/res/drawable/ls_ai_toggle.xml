<?xml version="1.0" encoding="utf-8"?>
<!-- Web search toggle: tonal when on (state_activated), plain when off. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ls_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <solid android:color="@color/ls_lyra_green_container" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
