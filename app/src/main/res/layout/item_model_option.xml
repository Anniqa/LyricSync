<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/ls_row_min" android:layout_marginBottom="@dimen/ls_space_2" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/ls_bg_option" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/model_option_icon" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_model_gemini" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/ls_space_3" android:paddingEnd="@dimen/ls_space_2">
        <TextView android:id="@+id/model_option_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.LyricSync.Main.Label" />
        <TextView android:id="@+id/model_option_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.LyricSync.Main.Caption" />
    </LinearLayout>
    <ImageView android:id="@+id/model_option_check" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check" app:tint="@color/ls_primary" android:contentDescription="@null" android:visibility="gone" />
</LinearLayout>
