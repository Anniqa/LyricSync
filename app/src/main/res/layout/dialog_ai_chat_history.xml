<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/overlay_bg_rounded" android:padding="16dp">
    <!-- Dialog Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_history" app:tint="@color/accent" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/ai_history_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_history_clear_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_history_clear_all" android:textColor="@color/state_error" android:textSize="12sp" android:textStyle="bold" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/bg_icon_button" android:clickable="true" android:focusable="true" android:layout_marginEnd="6dp" />
        <ImageView android:id="@+id/btn_history_close" android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:background="@drawable/bg_icon_button" android:src="@drawable/ic_close" app:tint="@color/text_secondary" android:contentDescription="@string/cd_close" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginBottom="12dp" />
    <!-- Empty view -->
    <LinearLayout android:id="@+id/layout_history_empty" android:layout_width="match_parent" android:layout_height="140dp" android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_history" app:tint="@color/text_dim" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/ai_history_empty" android:textColor="@color/text_dim" android:textSize="13sp" />
    </LinearLayout>
    <!-- Sessions Scroll List -->
    <ScrollView android:id="@+id/scroll_history_sessions" android:layout_width="match_parent" android:layout_height="360dp" android:fillViewport="true" android:scrollbars="vertical" android:fadeScrollbars="false">
        <LinearLayout android:id="@+id/container_history_sessions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>