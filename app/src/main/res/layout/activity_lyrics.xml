<?xml version="1.0" encoding="utf-8"?>
<!-- In-app full-screen lyrics: blurred album-tinted backdrop, header, scrolling lyrics, transport. See LyricsActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/lyrics_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ls_bg">
    <ImageView android:id="@+id/lyrics_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.35" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <View android:id="@+id/lyrics_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ls_lyrics_scrim" />

    <LinearLayout android:id="@+id/lyrics_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <!-- Header: close, cover + song (gets the room), compact Lyra pill. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/ls_space_1" android:paddingEnd="@dimen/ls_space_4">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/lyrics_close" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/ls_bg_transport" android:contentDescription="@string/lyrics_full_close" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_chevron_down" app:tint="@color/ls_on_surface" />
            <!-- Record sleeve + vinyl that slides out and spins while playing. -->
            <com.lyricsync.app.ui.lyrics.CoverDiscView android:id="@+id/lyrics_cover" android:layout_width="64dp" android:layout_height="52dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/ls_space_3" android:paddingEnd="@dimen/ls_space_3">
                <TextView android:id="@+id/lyrics_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="marquee" android:fadingEdgeLength="20dp" android:marqueeRepeatLimit="marquee_forever" android:requiresFadingEdge="horizontal" android:singleLine="true" android:textAppearance="@style/TextAppearance.LyricSync.Main.Title" />
                <TextView android:id="@+id/lyrics_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textAppearance="@style/TextAppearance.LyricSync.Main.Caption" />
            </LinearLayout>
            <LinearLayout android:id="@+id/lyrics_ask_lyra" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/ls_lyra_pill" android:clickable="true" android:contentDescription="@string/lyrics_full_ask_lyra" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="3dp" android:paddingEnd="12dp">
                <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/ls_ai_avatar_ring" android:padding="2dp">
                    <ImageView android:id="@+id/lyrics_lyra_face" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ls_mascot_proud" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:importantForAccessibility="no" android:text="@string/ai_mascot_name" android:textColor="@color/ls_lyra_platinum" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Display chips: the same Latin / original / translation switches as the overlay. -->
        <HorizontalScrollView android:id="@+id/lyrics_chips_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:overScrollMode="never" android:paddingStart="@dimen/ls_space_4" android:paddingEnd="@dimen/ls_space_4" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="@dimen/ls_space_1" android:paddingBottom="@dimen/ls_space_2">
                <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_chip_latin" style="@style/Widget.LyricSync.Lyrics.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lyrics_full_latin" app:icon="@drawable/ls_ic_latin" />
                <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_chip_original" style="@style/Widget.LyricSync.Lyrics.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_space_2" android:text="@string/lyrics_full_original" app:icon="@drawable/ls_ic_script" />
                <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_chip_translation" style="@style/Widget.LyricSync.Lyrics.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_space_2" android:text="@string/lyrics_full_translation" app:icon="@drawable/ls_ic_translate" />
                <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_chip_search" style="@style/Widget.LyricSync.Lyrics.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_space_2" android:checkable="false" android:text="@string/lyrics_full_search" app:icon="@drawable/ic_search" />
                <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/lyrics_chip_busy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_space_3" android:indeterminate="true" android:visibility="gone" app:indicatorColor="@color/ls_lyra_green" app:indicatorSize="18dp" app:trackThickness="2dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:id="@+id/lyrics_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:fadingEdgeLength="96dp" android:overScrollMode="never" android:requiresFadingEdge="vertical" android:scrollbars="none">
                <LinearLayout android:id="@+id/lyrics_lines" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical" android:paddingStart="@dimen/ls_space_5" android:paddingEnd="@dimen/ls_space_5" />
            </ScrollView>
            <LinearLayout android:id="@+id/lyrics_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="@dimen/ls_space_8" android:visibility="gone">
                <ImageView android:layout_width="56dp" android:layout_height="56dp" android:alpha="0.5" android:importantForAccessibility="no" android:src="@drawable/ic_lyrics_lines" app:tint="@color/ls_on_surface_variant" />
                <TextView android:id="@+id/lyrics_empty_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_space_4" android:gravity="center" android:textAppearance="@style/TextAppearance.LyricSync.Main.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_start" style="@style/Widget.LyricSync.Main.Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_space_4" android:text="@string/lyrics_full_start" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_empty_search" style="@style/Widget.LyricSync.Main.Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_space_4" android:text="@string/lyrics_full_search" android:visibility="gone" app:icon="@drawable/ic_search" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_resync" style="@style/Widget.LyricSync.Main.Button.Tonal" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="@dimen/ls_space_6" android:elevation="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:textSize="13sp" app:iconSize="16dp" android:text="@string/lyrics_full_resync" android:visibility="gone" app:icon="@drawable/ic_lyrics_lines" />
        </FrameLayout>

        <LinearLayout android:id="@+id/lyrics_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/ls_space_3" android:paddingEnd="@dimen/ls_space_3" android:paddingBottom="@dimen/ls_space_5">
            <!-- Combo in use, then the lyric-aware timeline (drag or tap anywhere to seek). -->
            <TextView android:id="@+id/lyrics_combo" android:layout_width="match_parent" android:paddingStart="@dimen/ls_space_4" android:paddingEnd="@dimen/ls_space_4" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:letterSpacing="0.06" android:maxLines="1" android:textAllCaps="true" android:textAppearance="@style/TextAppearance.LyricSync.Main.Overline" android:textColor="@color/ls_primary" />
            <com.lyricsync.app.ui.lyrics.TimelineView android:id="@+id/lyrics_timeline" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/lyrics_full_seek" />
            <!-- Transport: borderless skip buttons around a large accent disc. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_space_1" android:gravity="center" android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/lyrics_prev" android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/ls_bg_transport" android:contentDescription="@string/lyrics_full_prev" android:padding="18dp" android:scaleType="fitCenter" android:src="@drawable/ic_skip_previous" app:tint="@color/ls_on_surface" />
                <com.lyricsync.app.ui.lyrics.PlayPauseButton android:id="@+id/lyrics_play" android:layout_width="80dp" android:layout_height="80dp" android:layout_marginStart="@dimen/ls_space_8" android:layout_marginEnd="@dimen/ls_space_8" android:contentDescription="@string/lyrics_full_play" />
                <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/lyrics_next" android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/ls_bg_transport" android:contentDescription="@string/lyrics_full_next" android:padding="18dp" android:scaleType="fitCenter" android:src="@drawable/ic_skip_next" app:tint="@color/ls_on_surface" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
