<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ai_chat_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ai_chat_dialog_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/ai_chat_btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            android:contentDescription="@string/cd_collapse" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/ai_chat_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_studio_title"
                android:textAppearance="@style/TextAppearance.LyricSync.SectionTitle" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="1dp">

                <TextView
                    android:id="@+id/ai_chat_dialog_track_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ai_chat_dialog_mood_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginStart="6dp"
                    android:textColor="#E0E0E0"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_ok"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ai_chat_dialog_quota_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ai_chat_btn_new_chat"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_chat_new"
            app:tint="@color/accent"
            android:contentDescription="@string/ai_btn_new_chat" />

        <ImageView
            android:id="@+id/ai_chat_btn_history"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_history"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/ai_btn_history" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ── Model pill row ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/ai_studio_model_selector_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_prompt_card"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ai_studio_model_pill_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_model_gemini"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/ai_studio_model_pill_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                tools:text="Gemini 3.8 Flash"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_secondary"
                android:contentDescription="@null" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ai_studio_model_desc_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_model_gemini_flash_desc"
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- ── Quick chips ─────────────────────────────────────────── -->
    <HorizontalScrollView
        android:id="@+id/ai_studio_quick_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/ai_studio_quick_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ── Chat area ───────────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/ai_studio_chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ai_studio_chat_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </ScrollView>

    <!-- Empty state when no chat -->
    <LinearLayout
        android:id="@+id/ai_chat_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_sparkles"
            app:tint="@color/accent"
            android:alpha="0.6"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/ai_chat_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ai_empty_hint"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- ── Tool status pill ────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ai_tool_status_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_tool_status_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ai_tool_status_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search_globe"
            app:tint="#64B5F6"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/ai_tool_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#B8C4E0"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="240dp" />
    </LinearLayout>

    <!-- ── Input bar ───────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ai_chat_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chat_input_pill"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/ai_studio_web_search_chip"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_search_globe"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/ai_toggle_web_search"
            android:alpha="0.55" />

        <ImageView
            android:id="@+id/ai_studio_voice_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_mic"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/cd_voice_input" />

        <EditText
            android:id="@+id/ai_studio_chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:hint="@string/ai_chat_input_hint"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@null"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend"
            android:maxLines="4" />

        <ImageView
            android:id="@+id/ai_studio_chat_send"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_send_arrow"
            app:tint="@color/accent"
            android:contentDescription="@string/ai_send" />
    </LinearLayout>
</LinearLayout>
