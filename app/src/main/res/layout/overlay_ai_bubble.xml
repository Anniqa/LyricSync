<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_bubble_root"
    android:layout_width="50dp"
    android:layout_height="50dp"
    android:background="@drawable/bg_ai_bubble"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ai_bubble_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_sparkles"
        app:tint="@color/accent"
        android:contentDescription="@string/cd_ai_chat_bubble" />

    <View
        android:id="@+id/ai_bubble_badge"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_pill_ok"
        android:visibility="gone" />
</FrameLayout>
