<?xml version="1.0" encoding="utf-8"?>
<!-- Lyrics search (overlay dialog): edit the query, results stream in per source, tap one to use it; or paste lyrics. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ls_ai_panel" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_search" app:tint="@color/ls_lyra_green" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/lyrics_search_title" android:textColor="@color/ls_lyra_platinum" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/lyrics_search_mode" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/ls_ai_followup" android:text="@string/lyrics_search_paste" android:textColor="@color/ls_lyra_silver" android:textSize="12sp" />
    </LinearLayout>
    <!-- Search mode -->
    <LinearLayout android:id="@+id/lyrics_search_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
        <EditText android:id="@+id/lyrics_search_title_input" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/ls_ai_input" android:hint="@string/lyrics_search_title_hint" android:importantForAutofill="no" android:inputType="textCapSentences" android:maxLines="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/ls_lyra_platinum" android:textColorHint="@color/ls_lyra_muted" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <EditText android:id="@+id/lyrics_search_artist_input" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/ls_ai_input" android:hint="@string/lyrics_search_artist_hint" android:importantForAutofill="no" android:imeOptions="actionSearch" android:inputType="textCapWords" android:maxLines="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/ls_lyra_platinum" android:textColorHint="@color/ls_lyra_muted" android:textSize="14sp" />
            <ImageView android:id="@+id/lyrics_search_go" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/ls_ai_send" android:padding="11dp" android:src="@drawable/ic_search" app:tint="@color/ls_lyra_on_green" android:contentDescription="@string/lyrics_search_go" />
        </LinearLayout>
        <TextView android:id="@+id/lyrics_search_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/ls_lyra_muted" android:textSize="12sp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxHeight="320dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/lyrics_search_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
    <!-- Paste mode -->
    <LinearLayout android:id="@+id/lyrics_paste_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">
        <EditText android:id="@+id/lyrics_paste_input" android:layout_width="match_parent" android:layout_height="180dp" android:background="@drawable/ls_ai_card" android:gravity="top|start" android:hint="@string/lyrics_paste_hint" android:importantForAutofill="no" android:inputType="textMultiLine|textNoSuggestions" android:padding="12dp" android:scrollbars="vertical" android:textColor="@color/ls_lyra_platinum" android:textColorHint="@color/ls_lyra_muted" android:textSize="12sp" />
        <TextView android:id="@+id/lyrics_paste_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/lyrics_paste_formats" android:textColor="@color/ls_lyra_muted" android:textSize="11sp" />
        <TextView android:id="@+id/lyrics_paste_use" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:background="@drawable/ls_ai_send" android:gravity="center" android:text="@string/lyrics_use" android:textColor="@color/ls_lyra_on_green" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
