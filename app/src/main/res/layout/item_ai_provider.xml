<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable provider row (Google or a saved OpenAI-compatible provider). Selected = green outline + check. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/provider_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ls_space_2" android:minHeight="@dimen/ls_row_min" android:background="@drawable/ls_bg_option" android:baselineAligned="false" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/ls_space_3" android:paddingEnd="@dimen/ls_space_1">
    <FrameLayout android:id="@+id/provider_tile" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/ls_bg_logo_tile">
        <ImageView android:id="@+id/provider_logo" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/ls_space_3" android:paddingEnd="@dimen/ls_space_2">
        <TextView android:id="@+id/provider_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textAppearance="@style/TextAppearance.LyricSync.Main.Label" />
        <TextView android:id="@+id/provider_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textAppearance="@style/TextAppearance.LyricSync.Main.Caption" />
    </LinearLayout>
    <ImageView android:id="@+id/provider_check" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@string/provider_in_use" android:src="@drawable/ic_check" android:visibility="gone" app:tint="@color/ls_primary" />
    <ImageView android:id="@+id/provider_edit" android:layout_width="@dimen/ls_touch" android:layout_height="@dimen/ls_touch" android:background="?attr/selectableItemBackgroundBorderless" android:padding="14dp" android:src="@drawable/ls_ic_edit" app:tint="@color/ls_on_surface_variant" />
</LinearLayout>
