<?xml version="1.0" encoding="utf-8"?>
<!-- One fusion slot: label, element badge, style name. Fixed height so both slots line up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ls_lab_slot" android:clickable="true" android:focusable="true" android:gravity="center_horizontal" android:minHeight="140dp" android:orientation="vertical" android:paddingStart="@dimen/ls_space_3" android:paddingTop="@dimen/ls_space_4" android:paddingEnd="@dimen/ls_space_3" android:paddingBottom="@dimen/ls_space_4">
    <TextView android:id="@+id/slot_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.1" android:textAppearance="@style/TextAppearance.LyricSync.Main.Overline" />
    <FrameLayout android:id="@+id/slot_badge" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginTop="@dimen/ls_space_3" android:background="@drawable/ls_bg_logo_tile">
        <ImageView android:id="@+id/slot_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/slot_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_space_3" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textAppearance="@style/TextAppearance.LyricSync.Main.Label" />
    <TextView android:id="@+id/slot_element" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:letterSpacing="0.06" android:textAppearance="@style/TextAppearance.LyricSync.Main.Caption" android:textStyle="bold" />
</LinearLayout>
