<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg_rounded"
    android:padding="14dp">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ai_chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:src="@drawable/ic_ai_sparkle"
            app:tint="@color/accent"
            android:contentDescription="@string/ai_insights_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/ai_chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/ai_insights_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="1dp">

                <TextView
                    android:id="@+id/ai_chat_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/ai_mood_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginStart="6dp"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_ok"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ai_quota_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="9sp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ai_minimize_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="@string/cd_collapse" />

        <ImageView
            android:id="@+id/ai_close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/cd_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="8dp" />

    <!-- ── Center Canvas Area ──────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ── Empty State Canvas: Prompt Templates ─────────────── -->
        <ScrollView
            android:id="@+id/ai_chat_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/ai_empty_hint_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_empty_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/ai_prompt_templates_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ── Chat Messages Scroll ────────────────────────────── -->
        <ScrollView
            android:id="@+id/ai_chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ai_chat_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="6dp" />
        </ScrollView>
    </FrameLayout>

    <!-- ── Live AI Tool Status Pill ────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ai_tool_status_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_tool_status_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ai_tool_status_icon_view"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search_globe"
            app:tint="#64B5F6"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/ai_tool_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#B8C4E0"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="240dp" />
    </LinearLayout>

    <!-- ── Web Sources List ────────────────────────────────────── -->
    <HorizontalScrollView
        android:id="@+id/ai_web_sources_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ai_web_sources_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ── Claude/Gemini Style Chat Input Bar ──────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chat_input_pill"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/ai_web_search_chip"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_search_globe"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/ai_toggle_web_search"
            android:alpha="0.55" />

        <EditText
            android:id="@+id/ai_chat_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:hint="@string/ai_chat_input_hint"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@null"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:maxLines="1"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/ai_chat_send"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_send_arrow"
            app:tint="@color/accent"
            android:contentDescription="@string/ai_send" />
    </LinearLayout>

</LinearLayout>
