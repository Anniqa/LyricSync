<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg_rounded"
    android:padding="14dp">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ai_chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="3dp"
            android:src="@drawable/ic_sparkles"
            app:tint="@color/accent"
            android:contentDescription="AI Insights" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/ai_chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="✨ AI Insights" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ai_chat_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/ai_mood_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginStart="6dp"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_ok"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ai_quota_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="9sp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ai_minimize_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="Minimize to Bubble" />

        <ImageView
            android:id="@+id/ai_close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:contentDescription="Close AI" />
    </LinearLayout>

    <!-- ── Meaning Summary ─────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/ai_summary_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="80dp"
        android:layout_marginTop="2dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="true">

        <TextView
            android:id="@+id/ai_summary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:text="Tap ✨ untuk analisis makna lagu." />
    </ScrollView>

    <!-- ── Web Sources List ────────────────────────────────────── -->
    <HorizontalScrollView
        android:id="@+id/ai_web_sources_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ai_web_sources_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ── Quick Prompt Chips ──────────────────────────────────── -->
    <HorizontalScrollView
        android:id="@+id/ai_quick_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/ai_quick_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- ── Chat Messages Scroll ────────────────────────────────── -->
    <ScrollView
        android:id="@+id/ai_chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/ai_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- ── Chat Input Bar ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/ai_web_search_chip"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_search"
            android:contentDescription="Toggle Web Search"
            android:alpha="0.5" />

        <EditText
            android:id="@+id/ai_chat_input"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:hint="Ask about this song…"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_tip_box"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:maxLines="1"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/ai_chat_send"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
