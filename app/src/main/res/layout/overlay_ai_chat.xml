<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/ai_chat_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/ls_ai_panel" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">

    <!-- Header (also the drag handle): avatar, title + song, quota, actions -->
    <LinearLayout android:id="@+id/ai_chat_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="10dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/ls_ai_avatar_ring" android:padding="2dp">
            <ImageView android:id="@+id/ai_header_mascot" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ls_mascot" android:contentDescription="@string/ai_insights_title" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/ai_chat_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ls_lyra_platinum" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="@string/ai_insights_title" />
            <TextView android:id="@+id/ai_chat_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="@color/ls_lyra_silver" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/ai_quota_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/ls_ai_badge" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="@color/ls_lyra_silver" android:textSize="10sp" android:visibility="gone" />
        <ImageView android:id="@+id/ai_btn_new_chat" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:background="@drawable/bg_icon_button" android:src="@drawable/ic_chat_new" app:tint="@color/ls_lyra_silver" android:contentDescription="@string/ai_btn_new_chat" />
        <ImageView android:id="@+id/ai_btn_history" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="2dp" android:padding="7dp" android:background="@drawable/bg_icon_button" android:src="@drawable/ic_history" app:tint="@color/ls_lyra_silver" android:contentDescription="@string/ai_btn_history" />
        <ImageView android:id="@+id/ai_minimize_button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="2dp" android:padding="7dp" android:background="@drawable/bg_icon_button" android:src="@drawable/ic_chevron_down" app:tint="@color/ls_lyra_silver" android:contentDescription="@string/cd_collapse" />
        <ImageView android:id="@+id/ai_close_button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="2dp" android:padding="8dp" android:background="@drawable/bg_icon_button" android:src="@drawable/ic_close" app:tint="@color/ls_lyra_silver" android:contentDescription="@string/cd_close" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ls_lyra_outline" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <!-- Empty state: greeting + suggestion cards -->
        <ScrollView android:id="@+id/ai_chat_empty_state" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none" android:fillViewport="true" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="8dp">
                <!-- Lyra greets: portrait + a speech bubble -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/ls_ai_avatar_ring" android:padding="3dp">
                        <ImageView android:id="@+id/ai_mascot" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ls_mascot" android:contentDescription="@string/ai_mascot_cd" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical" android:background="@drawable/ls_ai_speech" android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_mascot_name" android:textColor="@color/ls_lyra_green" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/ai_greeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/ls_lyra_platinum" android:textSize="13sp" android:lineSpacingMultiplier="1.15" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/ai_empty_hint_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="10dp" android:text="@string/ai_empty_hint" android:textColor="@color/ls_lyra_silver" android:textSize="12sp" android:lineSpacingMultiplier="1.15" />
                <LinearLayout android:id="@+id/ai_prompt_templates_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        <!-- Conversation -->
        <ScrollView android:id="@+id/ai_chat_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
            <LinearLayout android:id="@+id/ai_chat_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="6dp" android:animateLayoutChanges="true" />
        </ScrollView>
    </FrameLayout>

    <!-- Live tool status, above the input -->
    <LinearLayout android:id="@+id/ai_tool_status_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/ls_ai_tool_chip" android:paddingStart="10dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <ImageView android:id="@+id/ai_tool_status_icon_view" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_search_globe" app:tint="@color/ls_lyra_green" android:contentDescription="@null" />
        <TextView android:id="@+id/ai_tool_status_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxWidth="240dp" android:textColor="@color/ls_lyra_silver" android:textSize="11sp" android:maxLines="1" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>

    <!-- Sources of the last answer -->
    <HorizontalScrollView android:id="@+id/ai_web_sources_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:scrollbars="none" android:overScrollMode="never" android:visibility="gone">
        <LinearLayout android:id="@+id/ai_web_sources_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Composer: web toggle, multi-line input, send -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="bottom" android:background="@drawable/ls_ai_input" android:padding="4dp">
        <ImageView android:id="@+id/ai_web_search_chip" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:background="@drawable/ls_ai_toggle" android:src="@drawable/ic_search_globe" app:tint="@color/ls_ai_toggle_tint" android:contentDescription="@string/ai_toggle_web_search" />
        <EditText android:id="@+id/ai_chat_input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:minHeight="36dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@null" android:hint="@string/ai_chat_input_hint" android:textColorHint="@color/ls_lyra_muted" android:textColor="@color/ls_lyra_platinum" android:textSize="13sp" android:inputType="textCapSentences" android:imeOptions="actionSend" android:maxLines="4" android:importantForAutofill="no" />
        <ImageView android:id="@+id/ai_chat_send" android:layout_width="36dp" android:layout_height="36dp" android:padding="9dp" android:background="@drawable/ls_ai_send" android:src="@drawable/ic_send_arrow" app:tint="@color/ls_lyra_on_green" android:contentDescription="@string/ai_send" />
    </LinearLayout>
</LinearLayout>
